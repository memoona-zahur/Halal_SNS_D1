# Copy to .env for local runs. Docker Compose sets DATABASE_URL itself.
# Every key below maps to a field in moderation/config.py (Settings).

# --- Database (required) ---------------------------------------------------
DATABASE_URL=postgresql://moderation:moderation@localhost:5432/moderation
DB_POOL_MAX_SIZE=10

# --- Models (worker only) ----------------------------------------------------
# Model revisions are pinned in moderation/config.py (MODEL_PINS); model_download.py pull downloads them.
TEXT_MODEL_DIR=models/qwen3guard-gen-0.6b
IMAGE_MODEL_DIR=models/siglip2-base-patch16-384
IMAGE_HEAD_DIR=models/siglip2-head
OCR_MODEL_DIR=models/rapidocr
# auto: GPU if usable, else CPU (slower). cuda: GPU or refuse to start. cpu: CPU only.
DEVICE=auto
OCR_THREADS=2
MODEL_MAX_BATCH=8

# --- Worker ----------------------------------------------------------------
FAST_WORKERS=4
# New jobs wake the worker by notification. This fallback poll picks up retries.
POLL_S=5.0
# A running job renews its lease every LEASE_S/3; a crashed worker's job is reclaimed after LEASE_S.
LEASE_S=20
MAX_ATTEMPTS=5

# --- Callbacks -------------------------------------------------------------
CALLBACK_TIMEOUT_S=5.0
CALLBACK_MAX_ATTEMPTS=10

# --- Images ----------------------------------------------------------------
# Comma-separated hostnames images may be downloaded from (https). Empty refuses every URL.
IMAGE_ALLOWED_HOSTS=
# Allow plain http:// to localhost, 127.0.0.1 or host.docker.internal. Dev only, local testing.
ALLOW_HTTP_LOCALHOST=false
# Folder for local image paths and raw uploads via POST /v1/moderations/uploads. Empty disables both.
# In Docker, use /app/uploads - that's the path docker-compose mounts as a volume shared between
# api (writes uploads) and worker (reads them back). A different path will not be visible to the worker.
IMAGE_ALLOWED_ROOT=
IMAGE_MAX_BYTES=10485760
FETCH_TIMEOUT_S=5.0

# --- API -------------------------------------------------------------------
API_MAX_IMAGES=10
API_MAX_BODY_BYTES=131072
API_MAX_TEXT_CHARS=10000
API_MAX_URL_CHARS=2048
# One X-API-Key per teammate: "name:key,name:key,...". Empty disables auth (local/CPU dev only -
# never run docker-compose.gpu.yml's ngrok tunnel with this empty).
API_KEYS=

# --- ngrok (team testing over docker-compose.gpu.yml's ngrok service only) -------------------
# Auth token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# A reserved free-tier domain, e.g. your-name.ngrok-free.app: https://dashboard.ngrok.com/domains
NGROK_DOMAIN=

LOG_LEVEL=INFO

# --- Tests only ------------------------------------------------------------
# Used by tests/integration (skipped when unset). Must name a database ending in _test.
TEST_DATABASE_URL=postgresql://moderation:moderation@localhost:5432/moderation_test

# --- Request limits ---
API_MAX_CALLBACK_URL_CHARS=500
# POST /v1/moderations waits this long for the decision and answers 200 with it; slower checks answer 202. 0: never wait.
API_WAIT_S=10
API_WAIT_POLL_S=0.1

